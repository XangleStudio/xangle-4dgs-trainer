+import json
+import random
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+from trigs.core import xangle_checkpoint as checkpoint_module
+from trigs.core.trainer import TrigsTrainer, TrigsTrainingConfig
+from trigs.core.xangle_checkpoint import TrainingCheckpoint, marker_path
+from trigs.cli import train_from_colmap as cli
+from tests.test_trainer import _fake_render, _make_params
+
+
+class Interrupted(Exception):
+    pass
+
+
+@pytest.mark.parametrize("sampling", ["official", "epoch"])
+def test_cpu_trainer_checkpoint_resume(tmp_path, monkeypatch, sampling):
+    draws = []
+
+    def render(self, params, cameras, cam_idx, t, sh_degree, config, step=None):
+        draws.append((step, cam_idx, t, random.random(), np.random.random(), torch.rand(()).item()))
+        return _fake_render(self, params, cameras, cam_idx, t, sh_degree, config, step)
+
+    monkeypatch.setattr(TrigsTrainer, "_render", render)
+    monkeypatch.setattr("trigs.core.trainer.reconstruction_loss",
+                        lambda pred, target, **_: (pred - target).abs().mean())
+    n_frames, n_cams = 4, 3
+    gt = {f: [torch.full((4, 4, 3), 20 * (f + c), dtype=torch.uint8)
+              for c in range(n_cams)] for f in range(n_frames)}
+    masks = {f: [torch.full((4, 4), 255, dtype=torch.uint8)
+                 for _ in range(n_cams)] for f in range(n_frames)}
+
+    def run(name, target, *, source=None, interval=0, stop=None):
+        stem = tmp_path / name / "state.pt"
+        torch.manual_seed(7)
+        random.seed(8)
+        np.random.seed(9)
+        config = TrigsTrainingConfig(
+            n_steps=target, verbose=False, fps=2.0, batch_cameras=2,
+            ssim_lambda=0,
+            camera_sampling=sampling, frame_sampling_fast_visits=0,
+            viewer_snapshot_dir=str(stem.parent / "viewer_snapshots"),
+            knn_recompute_every=2, unfreeze_temporal_step=3,
+            relocate_start_iter=1, relocate_every=2, relocate_tau_alpha=0.01,
+        )
+        ck = TrainingCheckpoint(stem, source, config, {"dataset": "example"}, interval=interval)
+        if stop:
+            write = ck.write
+
+            def stop_after_commit(step, *args, **kwargs):
+                write(step, *args, **kwargs)
+                if step == stop:
+                    raise Interrupted
+
+            ck.write = stop_after_commit
+        params = ck.parameters(torch.device("cpu")) if ck.state else _make_params(N=24)
+        result = TrigsTrainer(device="cpu").train_from_params(
+            params, 0, 1.0, [None] * n_cams, n_frames, gt, masks, config,
+            training_checkpoint=ck,
+        )
+        commit = json.loads(marker_path(stem).read_text())
+        payload = torch.load(stem.parent / commit["checkpointFile"], weights_only=True)
+        snapshot = torch.load(stem.parent / commit["snapshotFile"], weights_only=True)
+        assert snapshot["step"] == commit["completedSteps"] == target
+        assert snapshot["progress"] == 1
+        return stem, result, payload
+
+    _, uninterrupted, whole = run("whole", 8)
+    expected_draws = draws[:]
+    draws.clear()
+    with pytest.raises(Interrupted):
+        run("interrupted", 8, interval=2, stop=4)
+    old = tmp_path / "interrupted" / "state.pt"
+    assert json.loads(marker_path(old).read_text())["completedSteps"] == 4
+    final_stem, continued, final = run("continued", 8, source=old)
+    assert draws == expected_draws
+    for name in uninterrupted.params:
+        torch.testing.assert_close(uninterrupted.params[name], continued.params[name], rtol=0, atol=0)
+    torch.testing.assert_close(whole["optimizers"], final["optimizers"], rtol=0, atol=0)
+    torch.testing.assert_close(whole["loop"]["reloc_state"], final["loop"]["reloc_state"], rtol=0, atol=0)
+    _, _, extended = run("extended", 10, source=final_stem)
+    assert extended["info"]["scheduleSteps"] == 8
+    for name, state in extended["optimizers"].items():
+        assert state["param_groups"][0]["lr"] == final["optimizers"][name]["param_groups"][0]["lr"]
+    _, _, reexport = run("reexport", 8, source=final_stem)
+    torch.testing.assert_close(reexport["params"], final["params"], rtol=0, atol=0)
+
+
+def test_uncommitted_generation_never_replaces_prior_marker(tmp_path, monkeypatch):
+    config = TrigsTrainingConfig(n_steps=8, frame_sampling_fast_visits=0)
+    stem = tmp_path / "state.pt"
+    ck = TrainingCheckpoint(stem, None, config, {})
+    payload = ({"n_frames": 4}, _make_params(4), {}, {}, torch.device("cpu"))
+    ck.write(2, *payload)
+    prior = marker_path(stem).read_bytes()
+
+    def fail_commit(*args, **kwargs):
+        raise OSError("simulated failure before marker rename")
+
+    monkeypatch.setattr(checkpoint_module, "atomic_json", fail_commit)
+    with pytest.raises(OSError, match="simulated failure"):
+        ck.write(4, *payload)
+    assert marker_path(stem).read_bytes() == prior
+    assert TrainingCheckpoint(tmp_path / "next.pt", stem, config, {}).completed == 2
+    with pytest.raises(ValueError, match="Incompatible.*inputs"):
+        TrainingCheckpoint(tmp_path / "incompatible.pt", stem, config, {"different": True})
+    marker_path(stem).unlink()
+    with pytest.raises(FileNotFoundError):
+        TrainingCheckpoint(tmp_path / "missing.pt", stem, config, {})
+
+
+def test_colmap_cli_uses_marker_and_skips_canonical_initialization(tmp_path, monkeypatch):
+    data = tmp_path / "data"
+    data.mkdir()
+    image = data / "image.jpg"
+    image.write_bytes(b"fixed input")
+    npz = tmp_path / "keyframes.npz"
+    np.savez(npz, source_frame_start=0, source_frame_end=1, keyframe_step=1)
+    zeros = torch.zeros((4, 4, 3), dtype=torch.uint8)
+    scene = SimpleNamespace(
+        parser=SimpleNamespace(scene_scale=1.0), training_cam_ids=[0],
+        cameras=type("Cameras", (list,), {"viewmats": None})([None]), n_frames=2,
+        gt_images={0: [zeros], 1: [zeros]}, gt_alphas=None, gt_times=None,
+    )
+    initialized = []
+
+    def initialize(*_):
+        initialized.append(True)
+        return _make_params(24), 0, 1.0
+
+    monkeypatch.setattr(cli, "_initialize_colmap_params", initialize)
+    monkeypatch.setattr(cli, "build_colmap_scene", lambda _: scene)
+    monkeypatch.setattr(cli, "training_camera_extent", lambda *_, **__: 1.0)
+    monkeypatch.setattr(TrigsTrainer, "_render", _fake_render)
+    monkeypatch.setattr("trigs.core.trainer.reconstruction_loss",
+                        lambda pred, target, **_: (pred - target).abs().mean())
+
+    def run(name, target, source=None):
+        out = tmp_path / name
+        stem = out / "state.pt"
+        monkeypatch.setenv("XANGLE_TRIGS_STATE_OUT", str(stem))
+        monkeypatch.setenv("XANGLE_TRIGS_STATE_IN", str(source) if source else "")
+        args = cli.TrigsColmapArgs(
+            data_dir=data, npz_path=npz, output_dir=out, device="cpu",
+            config=TrigsTrainingConfig(n_steps=target, verbose=False, relocate=False,
+                                       frame_sampling_fast_visits=0, tb_log_every=0,
+                                       tb_stats_every=0),
+        )
+        cli.main(args)
+        assert (out / "trigs_ckpt.pt").is_file()
+        return stem
+
+    first = run("first", 2)
+    second = run("second", 3, first)
+    assert initialized == [True]
+    assert json.loads(marker_path(second).read_text())["completedSteps"] == 3
+    with pytest.raises(ValueError, match="precedes checkpoint"):
+        run("lower", 1, second)
+    image.write_bytes(b"changed input size")
+    with pytest.raises(ValueError, match="Incompatible.*inputs"):
+        run("changed", 4, second)
+    assert not marker_path(tmp_path / "changed" / "state.pt").exists()
