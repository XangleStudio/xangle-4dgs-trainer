+
+def marker_path(stem):
+    return stem.with_name(stem.name + ".json")
+
+
+def atomic_json(path, value):
+    pending = path.with_name(f".{path.name}.{uuid.uuid4().hex}.pending")
+    try:
+        with pending.open("xb") as file:
+            file.write(json.dumps(value, allow_nan=False).encode("ascii"))
+            file.flush()
+            os.fsync(file.fileno())
+        os.replace(pending, path)
+    finally:
+        pending.unlink(missing_ok=True)
+
+
+def committed_file(marker, name):
+    relative = Path(name)
+    if relative.is_absolute() or relative.drive or ".." in relative.parts:
+        raise ValueError(f"Invalid checkpoint-relative path: {name!r}")
+    path = (marker.parent / relative).resolve(strict=True)
+    if not path.is_relative_to(marker.parent.resolve()) or not path.is_file() or not path.stat().st_size:
+        raise ValueError(f"Invalid committed checkpoint file: {path}")
+    return path
+
+
+def checkpoint_info(path):
+    # The ZIP comment and tensors are published by the same rename. Reading
+    # progress does not import/unpickle model objects or scan tensor records.
+    with ZipFile(path) as archive:
+        info = json.loads(archive.comment)
+    if (not isinstance(info, dict)
+            or any(info.get(key) != value for key, value in CAPABILITY.items())
+            or type(info.get("version")) is not int
+            or type(info.get("completedSteps")) is not int
+            or info["completedSteps"] < 1
+            or type(info.get("scheduleSteps")) is not int
+            or info["scheduleSteps"] < 1
+            or info.get("lrPolicy") != LR_POLICY):
+        raise ValueError("Not a compatible Xangle TRiGS training checkpoint")
+    return info
+
+
+def runtime_fingerprint():
+    root = Path(__file__).resolve().parents[1]
+    digest = hashlib.sha256()
+    for path in sorted(root.rglob("*.py")):
+        digest.update(path.relative_to(root).as_posix().encode("utf-8") + b"\0")
+        digest.update(hashlib.sha256(path.read_bytes()).digest())
+    return digest.hexdigest()
+
+
+def rng_state(device):
+    algorithm, keys, pos, gaussian, cached = np.random.get_state()
+    return {
+        "python": random.getstate(),
+        "numpy": (algorithm, keys.tolist(), pos, gaussian, cached),
+        "torch": torch.get_rng_state(),
+        "cuda": torch.cuda.get_rng_state(device) if device.type == "cuda" else None,
+    }
+
+
+def restore_rng(state, device):
+    random.setstate(state["python"])
+    algorithm, keys, pos, gaussian, cached = state["numpy"]
+    np.random.set_state((algorithm, np.array(keys, dtype=np.uint32), pos, gaussian, cached))
+    torch.set_rng_state(state["torch"])
+    if device.type == "cuda":
+        torch.cuda.set_rng_state(state["cuda"], device)
+
+
+def restore_optimizers(optimizers, states):
+    if optimizers.keys() != states.keys():
+        raise ValueError("Checkpoint optimizer names do not match the trainer")
+    for name, optimizer in optimizers.items():
+        saved = states[name]
+        groups = saved["param_groups"]
+        if len(groups) != len(optimizer.param_groups):
+            raise ValueError(f"Checkpoint optimizer groups do not match: {name}")
+        ids = set()
+        for group, actual in zip(groups, optimizer.param_groups):
+            if len(group["params"]) != len(actual["params"]):
+                raise ValueError(f"Checkpoint optimizer parameters do not match: {name}")
+            for key, param in zip(group["params"], actual["params"]):
+                if key in ids:
+                    raise ValueError(f"Duplicate checkpoint optimizer parameter: {name}")
+                ids.add(key)
+                state = saved["state"].get(key, {})
+                if state:
+                    expected = {"step", "exp_avg", "exp_avg_sq"}
+                    if group.get("amsgrad"):
+                        expected.add("max_exp_avg_sq")
+                    if state.keys() != expected or state["step"].numel() != 1:
+                        raise ValueError(f"Invalid checkpoint Adam state: {name}")
+                    if any(state[m].shape != param.shape for m in expected - {"step"}):
+                        raise ValueError(f"Checkpoint Adam moment shape mismatch: {name}")
+        if not saved["state"].keys() <= ids:
+            raise ValueError(f"Unexpected checkpoint optimizer state: {name}")
+        optimizer.load_state_dict(saved)
+
+
+class TrainingCheckpoint:
+    def __init__(self, output, source, config, inputs, *, interval=DEFAULT_INTERVAL):
+        self.output = Path(output).resolve()
+        self.marker = marker_path(self.output)
+        self.interval = interval
+        self.horizon = config.n_steps
+        self.generations = []
+        if config.n_steps < 1 or interval < 0:
+            raise ValueError("Checkpoint mode requires positive n-steps and interval >= 0")
+        if self.output.exists() or self.marker.exists():
+            raise ValueError("Checkpoint output must be a new per-attempt stem")
+        if (config.temporal_chunk_len_s > 0 or config.temporal_hierarchy_enabled
+                or config.frame_sampling_fast_visits != 0 or config.frame_sampling_fast_frac != 0
+                or config.lr_schedule_total_steps != 0 or config.lr_schedule_offset_steps != 0
+                or config.lr_schedule_step_scale != 1):
+            raise ValueError("Checkpoint mode requires unchunked training without temporal hierarchy, "
+                             "fast-frame weighting or a chunk LR schedule")
+
+        settings = asdict(config)
+        for key in ("n_steps", "viewer_snapshot_dir", "viewer_snapshot_every",
+                    "viewer_snapshot_keep_last", "viewer_snapshot_keep_every",
+                    "viewer_snapshot_dtype"):
+            settings.pop(key, None)
+        self.contract = json.loads(json.dumps({
+            "config": settings,
+            "inputs": inputs,
+            "python": list(sys.version_info[:3]),
+            "torch": str(torch.__version__),
+            "numpy": np.__version__,
+            "runtime": runtime_fingerprint(),
+        }, default=str, sort_keys=True))
+        self.completed = 0
+        self.state = None
+        if source:
+            marker = marker_path(Path(source).resolve())
+            commit = json.loads(marker.read_text(encoding="utf-8"))
+            if (not isinstance(commit, dict) or type(commit.get("version")) is not int
+                    or any(commit.get(key) != value for key, value in CAPABILITY.items())
+                    or type(commit.get("completedSteps")) is not int
+                    or type(commit.get("scheduleSteps")) is not int):
+                raise ValueError("Invalid Xangle TRiGS checkpoint commit marker")
+            checkpoint = committed_file(marker, commit["checkpointFile"])
+            info = checkpoint_info(checkpoint)
+            if any(commit.get(key) != value for key, value in info.items()):
+                raise ValueError("Checkpoint header does not match commit marker")
+            if commit["snapshotFile"] is not None:
+                committed_file(marker, commit["snapshotFile"])
+            state = torch.load(checkpoint, map_location="cpu", weights_only=True)
+            if state["info"] != info:
+                raise ValueError("Checkpoint progress metadata does not match training state")
+            if state["contract"] != self.contract:
+                previous = state["contract"]
+                changed = [key for key in self.contract if self.contract[key] != previous.get(key)]
+                if "config" in changed:
+                    changed.extend(f"config.{key}" for key, value in self.contract["config"].items()
+                                   if value != previous.get("config", {}).get(key))
+                raise ValueError("Incompatible Xangle TRiGS checkpoint: " + ", ".join(changed))
+            self.completed = info["completedSteps"]
+            self.horizon = info["scheduleSteps"]
+            if self.completed > config.n_steps:
+                raise ValueError(f"Target {config.n_steps} precedes checkpoint step {self.completed}")
+            self.state = state
+
+    def parameters(self, device):
+        return torch.nn.ParameterDict({
+            name: torch.nn.Parameter(tensor.to(device), requires_grad=self.state["grad"][name])
+            for name, tensor in self.state.pop("params").items()
+        })
+
+    def due(self, completed, target):
+        return completed == target or (self.interval > 0 and completed % self.interval == 0)
+
+    def write(self, completed, scene, params, optimizers, loop, device, snapshot=None):
+        info = {**CAPABILITY, "completedSteps": completed, "scheduleSteps": self.horizon,
+                "lrPolicy": LR_POLICY}
+        checkpoint = self.output.with_name(f"{self.output.name}.s{completed:07d}.{uuid.uuid4().hex}.pt")
+        snapshot_relative = (str(snapshot.resolve().relative_to(self.marker.parent)).replace(os.sep, "/")
+                             if snapshot is not None else None)
+        payload = {
+            "info": info, "contract": self.contract, "scene": scene,
+            "params": {key: value.detach() for key, value in params.items()},
+            "grad": {key: value.requires_grad for key, value in params.items()},
+            "optimizers": {key: value.state_dict() for key, value in optimizers.items()},
+            "loop": loop, "rng": rng_state(device),
+        }
+        self.output.parent.mkdir(parents=True, exist_ok=True)
+        pending = self.output.with_name(f".{self.output.name}.{uuid.uuid4().hex}.pending")
+        try:
+            with pending.open("x+b") as file:
+                torch.save(payload, file)
+                with ZipFile(file, "a") as archive:
+                    archive.comment = json.dumps(info).encode("ascii")
+                file.flush()
+                os.fsync(file.fileno())
+            os.replace(pending, checkpoint)
+            atomic_json(self.marker, {**info, "checkpointFile": checkpoint.name,
+                                      "snapshotFile": snapshot_relative})
+        finally:
+            pending.unlink(missing_ok=True)
+        self.generations.append(checkpoint)
+        if len(self.generations) > 2:
+            old = self.generations.pop(0)
+            try:
+                old.unlink(missing_ok=True)
+            except OSError:
+                pass
+        print(f"[XANGLE_TRIGS_CHECKPOINT] completedSteps={completed}", flush=True)
+
+
+def input_identity(path):
+    path = Path(path).resolve(strict=True)
+    stat = path.stat()
+    return str(path), stat.st_size, stat.st_mtime_ns
+
+
+def input_tree(path):
+    root = Path(path).resolve(strict=True)
+    if not root.is_dir():
+        return input_identity(root)
+    return [str(root), [input_identity(p) for p in sorted(root.rglob("*")) if p.is_file()]]
